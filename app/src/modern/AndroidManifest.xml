<?xml version="1.0" encoding="utf-8"?>
<!--
  Intentionally empty.

  Everything this flavour needs is in the main manifest. Notably it asks for NO
  location permission: from API 31, BLUETOOTH_SCAN with neverForLocation covers
  printer discovery, so the legacy location grant is unnecessary. That also
  means aapt implies no location hardware feature, so this flavour cannot hit
  the required-feature install failure by construction.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" />
