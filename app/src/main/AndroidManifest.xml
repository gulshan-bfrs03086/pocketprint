<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network printing: IPP / IPPS / raw 9100.

         CHANGE_WIFI_MULTICAST_STATE is here for the multicast lock mDNS
         discovery holds while it browses; without it the Wi-Fi chip filters the
         multicast traffic away and no printer is ever found. ACCESS_WIFI_STATE
         is not needed for that and is not asked for. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Back, and this time something reads it. A printer-only access point has
         no internet, so Android keeps cellular as the default network and a
         socket opened without saying otherwise never reaches the printer.
         Finding the Wi-Fi network to bind to needs this. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Bluetooth thermal / label printers.

         Connect, and nothing else. There is no BLUETOOTH_SCAN here because this
         app no longer scans: pairing goes through the system's companion device
         picker, which does the scanning on the app's behalf, and printing after
         that works from the bonded list. An app that does not scan does not need
         permission to scan. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-feature android:name="android.software.companion_device_setup"
        android:required="false" />

    <!-- No storage or media permission of any kind, in either flavour.
         Documents are picked through the Storage Access Framework and arrive as
         a content:// URI already carrying its own read grant, which is the whole
         point of SAF. READ_MEDIA_IMAGES was declared here and READ_EXTERNAL_
         STORAGE in the legacy flavour; neither was ever requested at runtime, so
         they granted nothing and only invited a Play photo-policy review. -->

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="tiramisu" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- A print job drives a peripheral over Bluetooth, USB or the LAN, which is
         what connectedDevice describes. It was dataSync, which Android 15 caps
         at six hours a day and then times out; connectedDevice is not capped.
         Its prerequisite is met by CHANGE_WIFI_MULTICAST_STATE above and the
         usb.host feature below, so the service still starts for someone who
         only prints over the network and has granted no Bluetooth access. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
        tools:targetApi="34" />

    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <!-- BLE-only thermal printers are reached over GATT, not RFCOMM. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <!-- Nothing about printing needs hardware. Declaring these optional keeps
         the package installable on devices that lack them - a rugged terminal
         with no GPS, for instance. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".PocketPrintApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketPrint"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PocketPrint.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- USB printer hot-plug: jump straight into the app. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <!-- Share-sheet target: "Print" from any app.

             The types are listed rather than wildcarded. */* put PocketPrint in
             the share sheet for contacts, APKs and audio it has no idea how to
             print, which is both noise in every other app's share sheet and an
             invitation to hand it something it should not be reading. This list
             is what RenderPipeline.canRender accepts; subtype wildcards are not
             a thing in intent filters, so the office types are spelled out.

             The filter is not the check - an explicit intent bypasses it
             entirely - so ShareTargetActivity re-validates everything. -->
        <activity
            android:name=".ShareTargetActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:theme="@style/Theme.PocketPrint">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
            </intent-filter>

            <!-- "Open with" on a PDF. No BROWSABLE: that category exists so a
                 web page can launch an activity, and no web page has any
                 business launching this one. Opening a downloaded PDF from a
                 browser arrives as a content:// URI with the DEFAULT category
                 and is unaffected. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Publishes our printers to Android's print framework, so Bluetooth,
             USB and network printers appear in every app's Print dialog.
             The user enables it under Settings > Connected devices > Printing. -->
        <service
            android:name=".printservice.PocketPrintService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_PRINT_SERVICE">
            <intent-filter>
                <action android:name="android.printservice.PrintService" />
            </intent-filter>
            <meta-data
                android:name="android.printservice"
                android:resource="@xml/print_service" />
        </service>

        <service
            android:name=".print.PrintForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
